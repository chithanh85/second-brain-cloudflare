{
  "name": "second-brain",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create second-brain-db",
    "db:migrate": "wrangler d1 execute second-brain-db --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute second-brain-db --remote --file=schema.sql",
    "vectors:create": "wrangler vectorize create second-brain-vectors --dimensions=1024 --metric=cosine"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "agents": "^0.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.121.0"
  }
}
